{
  "name": "foliq",
  "version": "1.2.3",
  "description": "Foliq: Personal Finance Tracker PWA built with Next.js App Router, Neon PostgreSQL, Prisma ORM, and Tailwind CSS.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
