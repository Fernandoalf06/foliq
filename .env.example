# Neon Serverless PostgreSQL connection string
# Obtain automatically via `vercel integration add neon` or https://console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Single-owner access control (only this email can register or sign in)
OWNER_EMAIL="you@example.com"

# 32+ byte random hex string used to sign session tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET="replace-with-a-64-character-random-hex-secret"

# Public origin of the deployed PWA (used for canonical metadata and origin checks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
